POSTGRES_DB=nyc_transit
POSTGRES_USER=nyc
POSTGRES_PASSWORD=nyc

# Required for live MTA arrivals when running the API via docker compose (api service).
# Copy this file to .env and replace the placeholder. Do not commit .env.
MTA_API_KEY=YOUR_MTA_API_KEY_HERE

# Optional: comma-separated origins allowed to call /api/** from a browser (CORS).
# Default when unset: http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
